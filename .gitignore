# Willowbrook-specific gitignore

# Local dev artifacts
*.log
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp

# Generated / cached
node_modules/
.cache/

# Headless screenshot artifacts (regenerate from the game)
.critique/shots/critic*/
.critique/shots/critic2*/
.critique/shots/critic3*/

# Leftover from earlier sessions — never referenced by shipped code.
# Keep on disk only as a reference; ignore from git so the wave-4 ship stays
# procedural-only (per the user's no-Quaternius rule).
assets/models/

# Editor history
.history/
tools/__pycache__/
tools/*.pyc
