<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Willowbrook</title>
<style>
  :root {
    --hud-bg: rgba(248, 240, 220, 0.86);
    --hud-fg: #4a3a25;
    --hud-shadow: 0 2px 8px rgba(80, 60, 30, 0.18);
    --accent: #d68a4c;
  }
  html, body {
    margin: 0; padding: 0;
    width: 100%; height: 100%;
    background: #1c1410;
    overflow: hidden;
    font-family: 'Quicksand', 'Nunito', 'Helvetica Neue', sans-serif;
    color: var(--hud-fg);
    -webkit-font-smoothing: antialiased;
  }
  canvas { display: block; }

  /* Title splash */
  #splash {
    position: fixed; inset: 0;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
    background: linear-gradient(180deg, #fce8b8 0%, #f3b878 60%, #c47a3c 100%);
    z-index: 30;
    transition: opacity 0.6s ease;
  }
  #splash.hidden { opacity: 0; pointer-events: none; }
  #splash h1 {
    font-family: 'Quicksand', sans-serif;
    font-size: 72px;
    color: #fff;
    text-shadow: 0 4px 0 #c47a3c, 0 8px 16px rgba(80,40,10,0.4);
    margin: 0 0 8px 0;
    letter-spacing: 0.04em;
  }
  #splash .tag {
    color: #fff8e7;
    font-size: 18px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 32px;
    text-shadow: 0 2px 4px rgba(80,40,10,0.4);
  }
  #splash button {
    font-family: inherit;
    font-size: 22px;
    padding: 14px 36px;
    border: 0;
    border-radius: 32px;
    background: #fff;
    color: #c47a3c;
    cursor: pointer;
    box-shadow: 0 4px 0 #c47a3c, 0 8px 16px rgba(80,40,10,0.3);
    transition: transform 0.08s ease;
  }
  #splash button:active { transform: translateY(2px); box-shadow: 0 2px 0 #c47a3c, 0 4px 8px rgba(80,40,10,0.3); }

  /* HUD */
  .hud {
    position: fixed;
    background: var(--hud-bg);
    border-radius: 18px;
    padding: 10px 14px;
    box-shadow: var(--hud-shadow);
    pointer-events: none;
    z-index: 10;
    backdrop-filter: blur(6px);
  }
  #hud-top {
    top: 14px; left: 50%; transform: translateX(-50%);
    text-align: center;
    font-size: 16px;
    display: flex; gap: 18px; align-items: center;
  }
  #hud-top .clock { font-variant-numeric: tabular-nums; font-weight: 600; }
  #hud-top .bell::before { content: "🔔 "; }
  #hud-top .date::before { content: "📅 "; }

  #hud-bottom {
    bottom: 14px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 8px; pointer-events: auto;
  }
  .slot {
    width: 56px; height: 56px;
    background: #fff8e7;
    border-radius: 12px;
    border: 2px solid #e0c898;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
    box-shadow: inset 0 -3px 0 #e0c898;
    transition: transform 0.08s ease;
  }
  .slot.active {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: inset 0 -3px 0 var(--accent), 0 4px 8px rgba(214, 138, 76, 0.4);
  }
  .slot .key {
    position: absolute;
    margin-top: 64px;
    font-size: 10px;
    color: #8a7558;
  }

  #dialogue {
    position: fixed;
    bottom: 110px; left: 50%; transform: translateX(-50%);
    width: min(720px, 92vw);
    background: #fff8e7;
    border: 3px solid #6a4a2a;
    border-radius: 12px;
    padding: 18px 22px;
    box-shadow: 0 8px 24px rgba(80,40,10,0.4);
    z-index: 12;
    display: none;
    font-size: 16px;
    line-height: 1.5;
  }
  #dialogue.show { display: block; }
  #dialogue .name {
    display: inline-block;
    background: #6a4a2a;
    color: #fff8e7;
    padding: 4px 12px;
    border-radius: 6px;
    margin-bottom: 10px;
    font-size: 13px;
    letter-spacing: 0.05em;
  }
  #dialogue .next {
    position: absolute;
    bottom: 12px; right: 16px;
    font-size: 12px;
    color: #8a7558;
    animation: pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  #interact-prompt {
    position: fixed;
    top: 60%; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,0.6);
    color: #fff;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    display: none;
    z-index: 11;
  }
  #interact-prompt.show { display: block; }

  #toast {
    position: fixed;
    top: 80px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,0.65);
    color: #fff;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 15;
  }
  #toast.show { opacity: 1; }
</style>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div id="splash">
  <h1>Willowbrook</h1>
  <div class="tag">a cozy little town</div>
  <button id="start-btn">Visit Town</button>
</div>

<div id="hud-top" class="hud">
  <span class="date" id="hud-date">Spring 1</span>
  <span class="clock" id="hud-clock">06:00</span>
  <span class="bell" id="hud-bells">0</span>
</div>

<div id="hud-bottom" class="hud">
  <div class="slot active" data-slot="0">🌿<span class="key">1</span></div>
  <div class="slot" data-slot="1">🪓<span class="key">2</span></div>
  <div class="slot" data-slot="2">🪣<span class="key">3</span></div>
  <div class="slot" data-slot="3">🎣<span class="key">4</span></div>
</div>

<div id="dialogue">
  <div class="name" id="dialogue-name">Villager</div>
  <div id="dialogue-text">Hello there!</div>
  <div class="next">▼ press space</div>
</div>

<div id="interact-prompt">Press A to talk</div>

<div id="toast"></div>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  }
}
</script>
<script type="module" src="./src/main.js"></script>
</body>
</html>
